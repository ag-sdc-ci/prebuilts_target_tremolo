package {
    default_applicable_licenses: ["external_tremolo_license"],
}

license {
    name: "external_tremolo_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
    ],
    license_text: [
        "NOTICE",
    ],
}

prebuilt_apex {
    name: "org.blisslabs.ag.tremolo",
    apex_name: "org.blisslabs.ag.tremolo",
    source_apex_name: "org.blisslabs.ag.tremolo",
    arch: {
        x86_64: {
            src: "org.blisslabs.ag.tremolo.apex",
        },
    },
    filename: "org.blisslabs.ag.tremolo.apex",
    prefer: true,
    installable: true,
}

cc_prebuilt_library {
    name: "libvorbisidec",
    vendor_available: true,
    product_available: true,
    recovery_available: true,
    host_supported: true,
    shared_libs: ["liblog"],
    min_sdk_version: "29",
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
        "com.android.media",
        "com.android.media.swcodec",
    ],
    export_include_dirs: [
        "include",
        "include/tremolo",
        "include/Tremolo",
    ],
    shared: {
        srcs: ["lib/libvorbisidec.so"],
    },
    static: {
        srcs: ["lib/libvorbisidec.a"],
    },
}
